{
  "name": "civolyn",
  "version": "1.0.0",
  "description": "An original, fictional enterprise AI platform website by ISMAIL.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "test:static": "node scripts/verify-build.mjs",
    "verify": "npm run check && npm run build && npm run test:static && npm test",
    "assets:brand": "node scripts/create-brand-assets.mjs",
    "test:performance": "node scripts/performance.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts tsconfig.json README.md docs/*.md",
    "format:check": "prettier --check src scripts tests astro.config.mjs playwright.config.ts tsconfig.json README.md docs/*.md",
    "test:preview": "node scripts/check-preview.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismailabs/civolyn.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ismailabs/civolyn/issues"
  },
  "homepage": "https://github.com/ismailabs/civolyn#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "private": true
}
