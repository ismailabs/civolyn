---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="A little off the path"
  description="This page is not part of the CIVOLYN concept. Return to the platform or explore the product previews."
  noindex
>
  <section class="not-found">
    <p class="eyebrow">404 / A LITTLE OFF THE PATH</p>
    <h1>
      Let’s find
      <br />
      <em>a clearer direction.</em>
    </h1>
    <p>
      The page you’re looking for isn’t here. The platform and product previews
      are a good place to start again.
    </p>
    <div class="button-row">
      <a class="button button-blue" href="/">
        Back to the homepage <span aria-hidden="true">↗</span>
      </a>
      <a class="button button-outline" href="/platform/">
        Explore the platform
      </a>
    </div>
  </section>
</Layout>
