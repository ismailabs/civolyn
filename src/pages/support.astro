---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/site';
---

<Layout>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">SUPPORT & FREQUENTLY ASKED QUESTIONS</p>
      <h1>
        A little clarity
        <br />
        <em>goes a long way.</em>
      </h1>
      <p class="intro-copy">
        A guide to the product ideas, the local previews and the boundaries of
        this fictional project.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:20px">
    <div class="container support-layout">
      <aside class="support-aside">
        <p class="eyebrow">START HERE</p>
        <h2>
          Curious is
          <br />
          <em>a good place to be.</em>
        </h2>
        <p>
          There are no accounts to set up and no business tools to connect.
          Explore the supplied examples at your own pace.
        </p>
        <a class="arrow-link" href="/contact/">
          Choose a preview <span aria-hidden="true">↗</span>
        </a>
        <a class="arrow-link" href="/compare/">
          Compare the product ideas <span aria-hidden="true">↗</span>
        </a>
      </aside>
      <div class="faq-list">
        {faqs.map(([question, answer], i) => (
          <details id={i === 3 ? 'privacy' : undefined}>
            <summary>
              {question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section feature-demo-section">
    <div class="container">
      <p class="eyebrow">A FEW PRACTICAL DETAILS</p>
      <h2>
        Built to explore.
        <br />
        <em>Clear about its limits.</em>
      </h2>
      <div class="support-boundary">
        <div>
          <h3>When you refresh.</h3>
          <p>
            Workflow progress, search filters and selected reporting periods
            return to their starting state. The previews use browser memory
            rather than stored accounts or a database.
          </p>
          <p>
            If JavaScript is unavailable, the original example content and site
            links remain readable. Interactive filters and step changes need
            JavaScript to run.
          </p>
        </div>
        <div>
          <h3>When you leave this site.</h3>
          <p>
            ISMAIL’s portfolio and WhatsApp are genuine external destinations.
            Opening them is your choice; this site does not send a message,
            arrange a meeting or pass along the preview selections.
          </p>
          <p>
            For a real website enquiry, follow the separate ISMAIL links on the
            contact page. There is no CIVOLYN support desk or service agreement.
          </p>
        </div>
      </div>
      <a class="arrow-link" href="/contact/">
        Find the right next step <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
