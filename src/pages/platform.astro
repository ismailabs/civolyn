---
import Frame from '../components/PageFrame.astro';
import { products } from '../data/site';
const items = [
  {
    title: 'Connected, not complicated',
    body: 'One example journey ties requests, references and reporting together without hiding how each part works.',
  },
  {
    title: 'Simple hand-offs',
    body: 'A stage changes when its exit condition is met, with an owner and a clear next action.',
  },
  {
    title: 'Understandable information',
    body: 'Inspect the source of an answer and the figures behind a chart before relying on either.',
  },
];
---

<Frame label="Platform" items={items}>
  <section class="container section split-section">
    <div>
      <p class="eyebrow">FROM REQUEST TO PERSPECTIVE</p>
      <h2>One story, told in three useful ways.</h2>
      <p>
        A hypothetical creative team receives a project brief. Someone prepares
        the context, an approver checks the proposal, and a delivery owner takes
        the next step. Documentation explains the process; reporting makes the
        pattern visible.
      </p>
      <p class="demo-note">
        This relationship is conceptual. The three demos use separate local
        fixtures and do not synchronise business data.
      </p>
    </div>
    <ol class="lifecycle">
      <li>
        <span class="number">01</span>
        <div>
          <h3>Make the next step visible</h3>
          <p>
            Workflows shows Intake → Prepare → Human review → Hand-off. An
            approval gate pauses the process until you choose to proceed.
          </p>
        </div>
      </li>
      <li>
        <span class="number">02</span>
        <div>
          <h3>Keep context close</h3>
          <p>
            Knowledge offers six searchable sample references. Read an excerpt
            and check where it came from.
          </p>
        </div>
      </li>
      <li>
        <span class="number">03</span>
        <div>
          <h3>Check the pattern</h3>
          <p>
            Insights changes periods, totals, bars and table rows together.
            Counts are illustrative; they do not establish business results.
          </p>
        </div>
      </li>
    </ol>
  </section>
  <section class="container section">
    <div class="section-heading">
      <p class="eyebrow">CHOOSE A PERSPECTIVE</p>
      <h2>Explore the part that interests you.</h2>
    </div>
    <div class="product-grid">
      {products.map((p) => (
        <article class="product-card">
          <span class="product-symbol" aria-hidden="true">
            {p.symbol}
          </span>
          <h3>{p.name}</h3>
          <p>{p.description}</p>
          <a class="text-link" href={p.link}>
            Try {p.name} →
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="dark-section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">CLEAR BOUNDARIES</p>
        <h2>A useful model of a work system.</h2>
      </div>
      <div>
        <p>
          No external integrations, private documents, live data pipeline or
          deployed AI are connected. Trying an example changes only this
          browser’s local interface state. Reload the page to start fresh.
        </p>
        <a class="text-link" href="/technology/">
          Understand the actual architecture →
        </a>
        <a class="text-link" href="/compare/">
          Find a starting point →
        </a>
      </div>
    </div>
  </section>
</Frame>
