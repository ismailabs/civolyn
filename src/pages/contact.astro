---
import Frame from '../components/PageFrame.astro';
import { portfolio, products, whatsapp } from '../data/site';
const items = [
  {
    title: 'Try fictional product previews',
    body: 'Explore the local examples without registering, uploading documents or sharing business information.',
  },
  {
    title: 'See the real web studio',
    body: 'Visit ISMAIL to evaluate real design and development work and choose a genuine enquiry pathway.',
  },
  {
    title: 'No demo booking or sign-up',
    body: 'There is no PROWORKS sales desk. Every action here explains whether it is a demo or an external destination.',
  },
];
---

<Frame label="Contact" items={items}>
  <section class="container section contact-paths">
    <article class="contact-card" data-preview-picker>
      <p class="eyebrow">FICTIONAL PRODUCT / LOCAL EXAMPLES</p>
      <h2>Keep exploring the concept.</h2>
      <p>
        Choose a working demo with illustrative data. Nothing is submitted and
        no account is created.
      </p>
      <label for="preview-choice">What would you like to explore?</label>
      <select id="preview-choice" class="js-only">
        {products.map((p) => (
          <option value={p.id}>{p.name}</option>
        ))}
      </select>
      <a
        class="button"
        href="/products/workflows/#demo"
        data-preview-link
        data-event="contact_path_selected"
        data-component="contact-demo"
      >
        Open Workflows demo →
      </a>
      <noscript>
        <ul>
          {products.map((p) => (
            <li>
              <a href={p.link}>Explore {p.name}</a>
            </li>
          ))}
        </ul>
      </noscript>
    </article>
    <article class="contact-card real">
      <p class="eyebrow">REAL CREATOR / REAL WEBSITE PROJECTS</p>
      <h2>Discuss your website with ISMAIL.</h2>
      <p>
        Like the care behind this experience? Visit the separate ISMAIL
        portfolio for real website design, development and enquiry options.
      </p>
      <a
        class="button"
        href={portfolio}
        data-event="portfolio_cta_click"
        data-component="contact-real"
      >
        Explore ISMAIL <span aria-hidden="true">↗</span>
      </a>
      <a
        class="text-link"
        href={whatsapp}
        data-event="whatsapp_outbound_click"
        data-component="contact-whatsapp"
      >
        Discuss your website on WhatsApp <span aria-hidden="true">↗</span>
      </a>
      <p class="demo-note">
        External destination: ismailstudio.my. Opening the portfolio is not a
        submitted enquiry.
      </p>
    </article>
  </section>
  <section class="container section split-section">
    <div>
      <p class="eyebrow">A USEFUL START TO THE CONVERSATION</p>
      <h2>Bring the problem, not just the page count.</h2>
      <p>
        Think about who your website needs to help, the questions they ask and
        the next action they should be able to take. Existing pages, content and
        real feedback can help define the scope.
      </p>
    </div>
    <div class="reading">
      <h3>Prepare a short project brief</h3>
      <p>
        Describe your business and audience, the main website goal, what is
        frustrating today, and any practical timing or content constraints.
        Share private information only through the genuine enquiry channel you
        choose at ISMAIL.
      </p>
      <h3>Your information stays yours</h3>
      <p>
        PROWORKS has no enquiry form and does not collect message drafts or
        personal contact details. No analytics provider is currently configured.
        Demo activity is not a lead or a business outcome.
      </p>
      <a
        class="text-link"
        href="/journal/website-redesign-checklist-for-malaysian-smes/"
      >
        Read the redesign checklist →
      </a>
    </div>
  </section>
</Frame>
