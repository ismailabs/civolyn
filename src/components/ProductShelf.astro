---
import { products } from '../data/site';
---

<div class="product-shelf">
  {products.map((p, i) => (
    <article class:list={['product-feature', p.color]}>
      <div class="product-feature-head">
        <span class="product-number">0{i + 1} /</span>
        <span class="app-icon">{p.id === 'signal' ? '▥' : p.symbol}</span>
      </div>
      <p class="eyebrow">CIVOLYN {p.name.toUpperCase()}</p>
      <h3>{p.tagline}</h3>
      <p>{p.description}</p>
      <div class={`product-art product-art-${p.id}`} aria-hidden="true">
        {p.id === 'flow' ? (
          <div class="mini-flow">
            <span>
              Project intake <i>✓</i>
            </span>
            <b>↓</b>
            <span>
              Human review <i>○</i>
            </span>
            <b>↓</b>
            <span class="muted-step">
              Ready for the team <i>→</i>
            </span>
          </div>
        ) : p.id === 'knowledge' ? (
          <div class="mini-knowledge">
            <span>⌕ &nbsp; How do we start a project?</span>
            <div>
              <b>A considered start</b>
              <small>Operations handbook · § 2.1</small>
              <p>
                Begin with a brief.
                <br />
                Keep the context close.
              </p>
            </div>
          </div>
        ) : (
          <div class="mini-signal">
            <span>Weekly completions</span>
            <strong>
              126 <small>example workflows</small>
            </strong>
            <svg viewBox="0 0 240 80">
              <path
                d="M0 68L30 58L60 65L90 36L120 43L150 20L180 29L210 9L240 16"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              />
            </svg>
          </div>
        )}
      </div>
      <a class="arrow-link" href={p.link}>
        Explore {p.name} <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>
