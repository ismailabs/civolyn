---
import { articles } from '../data/articles';
---

<div class="article-cards">
  {articles.map((a, i) => (
    <article class="article-card">
      <div class="article-art" aria-hidden="true">
        <span>
          0{i + 1} / {['PROCESSES', 'WEBSITES', 'SIGNALS'][i]}
        </span>
        <strong>0{i + 1}</strong>
      </div>
      <div class="article-card-body">
        <p class="eyebrow">{a.category.toUpperCase()}</p>
        <h3>{a.title}</h3>
        <p>{a.description}</p>
        <p class="article-meta">ISMAIL · {a.minutes} minute read</p>
        <a href={`/journal/${a.slug}/`}>Read the field note →</a>
      </div>
    </article>
  ))}
</div>
