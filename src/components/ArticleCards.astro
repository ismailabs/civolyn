---
import { articles } from '../data/articles';
import Icon from './ProductIcon.astro';
---

<div class="article-cards">
  {articles.map((a, i) => (
    <article class="article-card">
      <div class="article-art" aria-hidden="true">
        <Icon kind={['workflows', 'knowledge', 'insights'][i]} />
      </div>
      <div class="article-card-body">
        <p class="eyebrow">{a.category.toUpperCase()}</p>
        <h3>{a.title}</h3>
        <p>{a.description}</p>
        <p class="article-meta">ISMAIL · {a.minutes} minute read</p>
        <a href={`/journal/${a.slug}/`}>Read the field note →</a>
      </div>
    </article>
  ))}
</div>
