---
import {
  documents,
  insightData,
  products,
  stages,
  portfolio,
} from '../data/site';
const { kind = 'workspace' } = Astro.props;
const d = insightData.week;
const total = d.completed.reduce((a, b) => a + b, 0);
const chart = ['workspace', 'platform', 'analytics'].includes(kind),
  list = ['knowledge', 'support', 'articles'].includes(kind),
  flow = ['workflow', 'tech', 'compare'].includes(kind);
---

<div
  class:list={['workspace', `workspace-${kind}`]}
  aria-label="Illustrative product preview"
>
  <div class="workspace-title">
    <b>
      PROWORKS <span aria-hidden="true"> / </span> SAMPLE WORKSPACE
    </b>
    <span>DEMO DATA</span>
  </div>
  <div class="workspace-body">
    <p class="mobile-demo-label">ILLUSTRATIVE DEMO — NOT LIVE</p>
    {chart && (
      <>
        <div class="preview-metrics">
          <div>
            <span>Completed</span>
            <strong>{total}</strong>
          </div>
          <div>
            <span>In review</span>
            <strong>{d.pending_review}</strong>
          </div>
          <div>
            <span>Median duration</span>
            <strong>{d.median_days}d</strong>
          </div>
        </div>
        <div class="preview-chart">
          <p>Illustrative activity, this week</p>
          <div
            role="img"
            aria-label={`Sample weekly completions: ${d.completed.join(', ')}. Total ${total}.`}
            class="preview-bars"
          >
            {d.completed.map((value, i) => (
              <div style={`--bar:${(value / 22) * 100}%`}>
                <span></span>
                <small>{d.labels[i]}</small>
              </div>
            ))}
          </div>
        </div>
      </>
    )}
    {list && (
      <div class="preview-library">
        <p class="preview-search">
          {kind === 'articles'
            ? 'Field notes / operations and design'
            : 'Search sample documents…'}
        </p>
        {documents.slice(0, 3).map((d) => (
          <div>
            <b>{d.title}</b>
            <small>{d.category} · Sample source available</small>
          </div>
        ))}
      </div>
    )}
    {flow && (
      <ol class="preview-flow">
        {(kind === 'compare'
          ? [...products.map((p) => p.name), 'Find your fit']
          : stages.map((s) => s.name)
        ).map((name, i) => (
          <li class:list={{ highlight: i === 2 }}>
            <span>{i + 1}</span>
            <b>{name}</b>
            <small>SAMPLE</small>
          </li>
        ))}
      </ol>
    )}
    {!chart && !list && !flow && (
      <div class="preview-paths">
        <a href="/compare/">
          <b>Choose a demo</b>
          <span>
            Three sample experiences <i aria-hidden="true">↗</i>
          </span>
        </a>
        <a href="/platform/">
          <b>Explore the product</b>
          <span>
            No signup required <i aria-hidden="true">↗</i>
          </span>
        </a>
        <a
          href={portfolio}
          data-event="portfolio_cta_click"
          data-component="preview"
        >
          <b>Talk to ISMAIL</b>
          <span>
            Real website services <i aria-hidden="true">↗</i>
          </span>
        </a>
      </div>
    )}
  </div>
</div>
