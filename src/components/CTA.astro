---
import { portfolio } from '../data/site';
const {
  compact = false,
  title = 'Interested in a site designed this thoughtfully?',
  body = 'The product is fictional. The design and development are real. Explore ISMAIL’s work and discuss a website for your business.',
} = Astro.props;
---

{compact ? (
  <aside class="container concept-strip">
    <p>
      FICTIONAL PROWORKS PLATFORM <span aria-hidden="true"> · </span> AN ISMAIL
      PORTFOLIO CONCEPT
    </p>
    <a
      href={portfolio}
      data-event="portfolio_cta_click"
      data-component="concept-strip"
    >
      Explore ISMAIL <span aria-hidden="true">→</span>
    </a>
  </aside>
) : (
  <section class="container conversion-bridge">
    <div>
      <p class="eyebrow">GOOD DESIGN HAS A REAL CREATOR</p>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <a
      class="button"
      href={portfolio}
      data-event="portfolio_cta_click"
      data-component="creator-bridge"
    >
      Discuss your website with ISMAIL <span aria-hidden="true">↗</span>
    </a>
  </section>
)}
