---
import Logo from './Logo.astro';
import { products, portfolio } from '../data/site';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label="PROWORKS home">
      <Logo />
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="primary-nav" aria-label="Main navigation">
      <a
        href="/platform/"
        aria-current={path === '/platform/' ? 'page' : undefined}
      >
        Platform
      </a>
      <details class="nav-group">
        <summary>
          Products <span aria-hidden="true">⌄</span>
        </summary>
        <div class="product-menu">
          {products.map((p) => (
            <a
              href={p.link}
              aria-current={path === p.link ? 'page' : undefined}
            >
              <span class="product-symbol" aria-hidden="true">
                {p.symbol}
              </span>
              <span>
                <b>{p.name}</b>
                <small>{p.detail}</small>
              </span>
            </a>
          ))}
          <a href="/compare/">
            Compare all three <span aria-hidden="true">→</span>
          </a>
        </div>
      </details>
      <a
        class="nav-product-shortcut"
        href="/products/knowledge/"
        aria-current={path === '/products/knowledge/' ? 'page' : undefined}
      >
        Knowledge
      </a>
      <a
        class="nav-product-shortcut"
        href="/products/insights/"
        aria-current={path === '/products/insights/' ? 'page' : undefined}
      >
        Insights
      </a>
      <a
        href="/guides/"
        aria-current={path === '/guides/' ? 'page' : undefined}
      >
        Guides
      </a>
      <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>
        About
      </a>
      <a
        class="button header-cta"
        href={portfolio}
        data-event="portfolio_cta_click"
        data-component="header"
      >
        Talk to ISMAIL <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
