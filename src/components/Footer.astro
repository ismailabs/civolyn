---
import Logo from './Logo.astro';
import { products, portfolio } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" aria-label="PROWORKS home">
        <Logo />
      </a>
      <p>Make room for work that moves.</p>
      <p class="footer-disclosure">
        Fictional concept by ISMAIL. Sample data and browser-only demos. No
        software subscription or connected AI.
      </p>
    </div>
    <nav aria-label="Product navigation">
      <b>Explore the concept</b>
      <a href="/platform/">Platform</a>
      {products.map((p) => (
        <a href={p.link}>{p.name}</a>
      ))}
      <a href="/compare/">Compare products</a>
    </nav>
    <nav aria-label="Learn and understand">
      <b>A little more context</b>
      <a href="/technology/">Technology</a>
      <a href="/experience/">Experience</a>
      <a href="/journal/">Journal</a>
      <a href="/guides/">Guides & FAQs</a>
      <a href="/about/">About the concept</a>
    </nav>
    <div class="footer-creator">
      <b>The real creator</b>
      <p>Thoughtful websites for real businesses.</p>
      <a
        href={portfolio}
        data-event="portfolio_cta_click"
        data-component="footer"
      >
        Explore ISMAIL <span aria-hidden="true">↗</span>
      </a>
      <a href="/contact/">Choose your next step →</a>
      <a href="/guides/#privacy">Privacy & demo boundaries</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>
      © {new Date().getUTCFullYear()} PROWORKS · An original ISMAIL portfolio
      concept.
    </p>
    <p>No analytics provider configured. Demo input stays local.</p>
  </div>
</footer>
