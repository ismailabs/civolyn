---
import { insightData } from '../data/site';
const d = insightData.week,
  total = d.completed.reduce((a, b) => a + b, 0);
---

<div class="demo-shell signal-demo" data-signal>
  <div class="demo-toolbar">
    <div>
      <b>The rhythm of your operations.</b>
      <small>PROWORKS Insights · Local demo / fictional product</small>
    </div>
    <div class="period-select">
      <label for="signal-period">Period</label>
      <select id="signal-period" data-signal-period>
        <option value="week">This week</option>
        <option value="month">This month</option>
        <option value="quarter">This quarter</option>
      </select>
    </div>
  </div>
  <div class="signal-body">
    <p class="mini-label">ILLUSTRATIVE DATA — NOT REAL BUSINESS RESULTS</p>
    <div class="signal-metrics">
      <div>
        <span>Completed workflows</span>
        <strong data-signal-total>{total}</strong>
        <small>Sum of the selected series</small>
      </div>
      <div>
        <span>Awaiting review</span>
        <strong data-signal-review>{d.pending_review}</strong>
        <small>Separate illustrative snapshot</small>
      </div>
      <div>
        <span>Median duration</span>
        <strong data-signal-time>{d.median_days} days</strong>
        <small>Prepared sample, not derived from counts</small>
      </div>
    </div>
    <div class="signal-chart-header">
      <div>
        <h3>Work completed, in perspective.</h3>
        <p data-signal-summary>Illustrative daily completions for this week.</p>
      </div>
      <span class="chart-key">Completed workflows</span>
    </div>
    <div
      class="signal-chart"
      role="img"
      aria-label={`Illustrative week completions: ${d.labels.map((l, i) => `${l} ${d.completed[i]}`).join(', ')}. Total ${total}. Full data in the table below.`}
      data-signal-chart
    >
      <div class="signal-bars" aria-hidden="true" data-signal-bars>
        {d.labels.map((label, i) => (
          <div>
            <b>{d.completed[i]}</b>
            <span
              style={`--bar:${(d.completed[i] / Math.max(...d.completed)) * 140}px`}
            ></span>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
    <p class="signal-insight" role="status" data-signal-insight>
      This week: {total} illustrative completions. Counts alone do not explain
      quality or workload.
    </p>
    <details class="data-disclosure">
      <summary>Read the underlying example data</summary>
      <div class="table-wrap">
        <table>
          <caption>
            Illustrative workflow completions —
            <span data-signal-caption>this week</span>
          </caption>
          <thead>
            <tr>
              <th scope="col">Period</th>
              <th scope="col">Completed workflows</th>
            </tr>
          </thead>
          <tbody data-signal-table>
            {d.labels.map((l, i) => (
              <tr>
                <th scope="row">{l}</th>
                <td>{d.completed[i]}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td data-signal-table-total>{total}</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </details>
    <button class="text-button signal-reset js-only" data-signal-reset>
      Reset dashboard
    </button>
  </div>
</div>
