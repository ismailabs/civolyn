---
import { stages } from '../data/site';
---

<div class="demo-shell flow-demo" data-flow>
  <div class="demo-toolbar">
    <div>
      <b>Client onboarding</b>
      <small>PROWORKS Workflows · Local demo / fictional product</small>
    </div>
    <span class="sample-pill">Illustrative data</span>
  </div>
  <div class="flow-canvas">
    <p class="mini-label">INTAKE → PREPARE → HUMAN REVIEW → HAND-OFF</p>
    <ol class="flow-steps">
      {stages.map((s, i) => (
        <li data-step={i} class:list={{ current: i === 0 }}>
          <span class="step-icon">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <b>{s.name}</b>
            <small>{s.description}</small>
            <small>Owner: {s.owner}</small>
          </div>
          <span class="step-status">{i === 0 ? 'Ready' : 'Waiting'}</span>
        </li>
      ))}
    </ol>
    <aside class="approval-proposal" aria-labelledby="proposal-title">
      <h3 id="proposal-title">Sample proposal for human review</h3>
      <p>
        Accept the example brief, assign the delivery owner and agree the first
        scope review as the next milestone. No client is contacted and no
        external work is created.
      </p>
      <label class="js-only">
        <input type="checkbox" data-flow-confirm disabled /> I have reviewed
        this sample proposal.
      </label>
    </aside>
  </div>
  <div class="demo-controls">
    <button class="button" data-flow-next>
      Start example →
    </button>
    <button class="button" data-flow-approve disabled hidden>
      Approve example →
    </button>
    <button class="text-button" data-flow-reset>
      Reset demo
    </button>
  </div>
  <p class="demo-status" role="status" aria-live="polite" data-flow-status>
    Ready when you are. This example runs only in your browser.
  </p>
  <details class="activity">
    <summary>Read the local activity history</summary>
    <ol data-flow-log>
      <li>Example ready. Intake is the current stage.</li>
    </ol>
  </details>
</div>
