<div class="demo-shell flow-demo" data-flow>
  <div class="demo-toolbar">
    <div>
      <span class="app-icon blue">↗</span>
      <div>
        <b>Client onboarding</b>
        <small>CIVOLYN Flow · Local preview</small>
      </div>
    </div>
    <span class="sample-pill">Illustrative data</span>
  </div>
  <div class="flow-canvas">
    <p class="mini-label">A CLEAR PATH FROM HELLO TO HANDOVER</p>
    <ol class="flow-steps">
      <li data-step="0" class="current">
        <span class="step-icon">01</span>
        <div>
          <b>A brief arrives</b>
          <small>A sample project request enters the queue.</small>
        </div>
        <span class="step-status">Ready</span>
      </li>
      <li data-step="1">
        <span class="step-icon">02</span>
        <div>
          <b>Gather the context</b>
          <small>Prepare an example project summary.</small>
        </div>
        <span class="step-status">Waiting</span>
      </li>
      <li data-step="2">
        <span class="step-icon review-icon">03</span>
        <div>
          <b>A person reviews</b>
          <small>Check the proposal before it moves on.</small>
        </div>
        <span class="step-status">Waiting</span>
      </li>
      <li data-step="3">
        <span class="step-icon">04</span>
        <div>
          <b>Ready for the team</b>
          <small>Keep the next step and its owner visible.</small>
        </div>
        <span class="step-status">Waiting</span>
      </li>
    </ol>
  </div>
  <div class="demo-controls">
    <button class="button button-blue" data-flow-next>
      Start example <span aria-hidden="true">→</span>
    </button>
    <button class="text-button" data-flow-reset>
      Reset preview
    </button>
  </div>
  <p class="demo-status" role="status" aria-live="polite" data-flow-status>
    Ready when you are. This example runs only in your browser.
  </p>
</div>
